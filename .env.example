# ============================================================
# Educational Chatbot — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real API key.
# ============================================================

# ----------------------------------------------------------
# LLM Provider selection
# ----------------------------------------------------------
# Set to true to use local Ollama instead of OpenAI
USE_OLLAMA=false

# ----------------------------------------------------------
# OpenAI (required when USE_OLLAMA=false)
# ----------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default model
MODEL_NAME=gpt-4o-mini

# ----------------------------------------------------------
# Ollama — local server (required when USE_OLLAMA=true)
# ----------------------------------------------------------
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ----------------------------------------------------------
# LLM Resilience (Sprint 1)
# ----------------------------------------------------------
# Maximum number of retry attempts on transient errors (rate limits, timeouts)
# LLM_MAX_RETRIES=3

# Hard timeout per LLM call in seconds (prevents indefinite hangs)
# LLM_TIMEOUT_SECONDS=60

# ----------------------------------------------------------
# UI defaults (optional overrides — useful for testing)
# ----------------------------------------------------------
# DEFAULT_LANGUAGE=en          # "en" or "he"
# DEFAULT_PREP_MINUTES=3       # Preparation timer default (1-10)
# DEFAULT_TEACHING_MINUTES=10  # Teaching session timer default (3-30)
# DEFAULT_STUDENT_AGE=10       # Student age spinner default (8-18)
