# ============================================================
# Educational Chatbot — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real API key.
# ============================================================

# ----------------------------------------------------------
# LLM Provider selection
# ----------------------------------------------------------
# Set to true to use local Ollama instead of OpenAI
USE_OLLAMA=false

# ----------------------------------------------------------
# OpenAI (required when USE_OLLAMA=false)
# ----------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default model
MODEL_NAME=gpt-4o-mini

# ----------------------------------------------------------
# Ollama — local server (required when USE_OLLAMA=true)
# ----------------------------------------------------------
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ----------------------------------------------------------
# LLM Resilience (Sprint 1)
# ----------------------------------------------------------
# Maximum number of retry attempts on transient errors (rate limits, timeouts)
# LLM_MAX_RETRIES=3

# Hard timeout per LLM call in seconds (prevents indefinite hangs)
# LLM_TIMEOUT_SECONDS=60

# ----------------------------------------------------------
# UI defaults (optional overrides — useful for testing)
# ----------------------------------------------------------
# DEFAULT_LANGUAGE=en          # "en" or "he"
# DEFAULT_PREP_MINUTES=3       # Preparation timer default (1-10)
# DEFAULT_TEACHING_MINUTES=10  # Teaching session timer default (3-30)
# DEFAULT_STUDENT_AGE=10       # Student age spinner default (8-18)

# ----------------------------------------------------------
# Google Cloud Integration (required for cloud deployment)
# ----------------------------------------------------------
# 1. Create a Google Cloud project and enable Sheets API + Drive API
# 2. Create a service account, download the JSON key
# 3. Create a Google Sheet with two tabs: "Sessions" and "Evaluations"
# 4. Create a Google Drive folder for transcripts
# 5. Share BOTH the Sheet and the Drive folder with the service account email
# 6. Fill in the IDs below:

# Spreadsheet ID — from the Sheet URL: docs.google.com/spreadsheets/d/{THIS_ID}/edit
# GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# Google Drive folder ID — from the folder URL: drive.google.com/drive/folders/{THIS_ID}
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# Path to service account JSON key file (for LOCAL development only).
# On Streamlit Cloud, paste the JSON contents into st.secrets instead.
# GOOGLE_CREDENTIALS_FILE=path/to/service-account.json

# ----------------------------------------------------------
# Teacher app security
# ----------------------------------------------------------
# Simple password gate for the teacher app. Leave empty for open access.
# TEACHER_PASSWORD=your-password-here

# ----------------------------------------------------------
# Deployment URLs
# ----------------------------------------------------------
# Base URL of the student Streamlit app (used to generate share links).
# On Streamlit Cloud this will be something like: https://student-chatbot.streamlit.app
# STUDENT_APP_URL=http://localhost:8502
